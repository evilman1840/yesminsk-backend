PORT=4000
MONGODB_URI=mongodb://localhost:27017/yesminsk
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER
# Сколько секунд initData из Telegram считается действительным (по умолчанию сутки)
TELEGRAM_INIT_DATA_MAX_AGE_SEC=86400
NODE_ENV=development
ANTHROPIC_API_KEY=sk-ant-...  # афиша из Telegram-каналов (Claude Haiku)
# AFISHA_CHANNELS=minsk_kuda,Minsk_kudaGo

# PostHog: выключено, пока POSTHOG_ENABLED не равен 1.
POSTHOG_ENABLED=0
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
# Аккаунты из ADMIN_TELEGRAM_IDS исключены автоматически.
POSTHOG_EXCLUDE_TELEGRAM_IDS=
